NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase / Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitonroom
DB_SSL=false
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret

# Security
DEVICE_INSTALL_HASH_SECRET=replace_with_random_long_secret

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_RAW_BUCKET=fitonroom-raw-dev
S3_RESULTS_BUCKET=fitonroom-results-dev
S3_UPLOAD_EXPIRES_SECONDS=900
SQS_TRY_ON_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/fitonroom-try-on-dev

# Optional delivery / payments / providers
CLOUDFRONT_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GENAI_TRY_ON_API_URL=
GENAI_TRY_ON_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=
